+// Generic application fixture: real placement controls, synthetic registry boundary; no render/media writes.
+import vm from 'node:vm';
+import assert from 'node:assert/strict';
+import {existsSync,readFileSync} from 'node:fs';
+const source=new URL('../ui/blender-placement.js',import.meta.url);
+function fixture(options={}){
+ const nodes=new Map(),calls=[],copied=[];let live=true,job={state:'completed',partial:false,job:'magicstudio-blender-fixture',character:'paper-puppet',track:'wave',canvas:[64,96],clip_seconds:3,...options.job};
+ const el=(tag,attrs={},...children)=>{const n={tag,...attrs,children:children.flat(),style:{},events:{},textContent:children.filter(c=>typeof c==='string').join(''),_value:attrs.value,
+  append(...c){this.children.push(...c)},replaceChildren(...c){this.children=c},addEventListener(type,fn){this.events[type]=fn},setAttribute(k,v){this[k]=v},
+  get options(){return this.children.filter(c=>c?.tag==='option')},get value(){return this._value??this.options[0]?.value??''},set value(v){this._value=String(v)},
+ };if(attrs.id)nodes.set(attrs.id,n);return n;};
+ const context=vm.createContext({console,JSON,el,navigator:{clipboard:{writeText:async text=>copied.push(text)}},motionCommand:async(id,params)=>{
+  calls.push({id,params});if(id==='storyboard.toc'){if(options.sceneError)throw Error('Scene source unavailable');return {chapters:options.empty?[]:[{scene:7,title:'Opening'},{scene:9,title:'Bridge'}]};}
+  if(id==='storyboard.read')return params.scene===7?{scene:7,start:12,end:14}:{scene:9,start:18,end:21};
+  if(id==='video.place_track'){if(options.place)return options.place(params);return {...params,ok:true,canvas_rect:params.rect,media:'/generic/hyperframes/assets/animation/placed.webm',backup:'/generic/hyperframes/.magicstudio-history/index.html',track_index:2};}
+  throw Error(`Unexpected command ${id}`);
+ }});
+ if(existsSync(source))vm.runInContext(readFileSync(source,'utf8'),context);
+ assert.equal(typeof context.blenderPlacementControls,'function','Place in scene controls must exist');
+ const panel=context.blenderPlacementControls({project:'/generic/Study.magic',getJob:()=>job,current:()=>live});
+ return {panel,nodes,calls,copied,setJob:value=>{job=value;panel.refresh()},close:()=>{live=false},change:async(id,value)=>{const n=nodes.get(id);n.value=value;await (n.events.change||n.events.input)?.()},click:id=>nodes.get(id).onclick(),status:()=>nodes.get('blender-place-status').textContent};
+}
+const tests=[
+ ['uses authored scenes and exact frozen-job request/CLI, confirms actual returned placement',async()=>{const f=fixture();await f.panel.load();assert.equal(f.nodes.get('blender-place-scene').options[0].value,'7');assert.equal(f.nodes.get('blender-place-start').value,'12');assert.equal(f.nodes.get('blender-place-duration').value,'2');const command="mc exec video.place_track 'project=/generic/Study.magic' 'id=blender-scene-7-wave' 'blender_job=magicstudio-blender-fixture' 'scene=7' 'start=12' 'duration=2' 'rect=[0,0,64,96]' 'playback_rate=1' 'character=paper-puppet' 'track=wave'";assert.equal(f.nodes.get('blender-place-command').textContent,command);await f.click('blender-place-copy');assert.equal(f.copied[0],command);await f.click('blender-place-submit');const p=f.calls.find(c=>c.id==='video.place_track').params;assert.equal(JSON.stringify(p),JSON.stringify({id:'blender-scene-7-wave',blender_job:'magicstudio-blender-fixture',scene:7,start:12,duration:2,rect:[0,0,64,96],playback_rate:1,character:'paper-puppet',track:'wave'}));assert.match(f.status(),/Placed.*scene 7.*track 2/);const readback=JSON.parse(f.nodes.get('blender-place-result').textContent);assert.equal(readback.blender_job,p.blender_job);assert.equal(readback.track_index,2);assert.ok(readback.backup)}],
+ ['partial/missing/running receipts cannot be placed',async()=>{for(const job of [{partial:true},{state:'running'},{partial:undefined}]){const f=fixture({job});await f.panel.load();assert.equal(f.nodes.get('blender-place-submit').disabled,true);await f.click('blender-place-submit');assert.equal(f.calls.some(c=>c.id==='video.place_track'),false);assert.match(f.status(),/full|completed/i)}}],
+ ['duration honors playback rate and invalid rect/id never dispatch',async()=>{const f=fixture();await f.panel.load();await f.change('blender-place-rate',2);await f.click('blender-place-submit');assert.match(f.status(),/covers.*1.5/);assert.equal(f.calls.some(c=>c.id==='video.place_track'),false);await f.change('blender-place-duration',1);await f.change('blender-place-width',0);await f.click('blender-place-submit');assert.match(f.status(),/rectangle/i);await f.change('blender-place-width',64);await f.change('blender-place-id','bad id');await f.click('blender-place-submit');assert.match(f.status(),/ID/);assert.equal(f.calls.some(c=>c.id==='video.place_track'),false)}],
+ ['scene change uses authored timing and preserves a user placement ID',async()=>{const f=fixture();await f.panel.load();await f.change('blender-place-id','existing-placement');await f.change('blender-place-scene',9);assert.equal(f.nodes.get('blender-place-start').value,'18');assert.equal(f.nodes.get('blender-place-duration').value,'3');assert.equal(f.nodes.get('blender-place-id').value,'existing-placement')}],
+ ['no authored scenes and scene read errors stay visible',async()=>{for(const opts of [{empty:true},{sceneError:true}]){const f=fixture(opts);await f.panel.load();assert.equal(f.nodes.get('blender-place-submit').disabled,true);assert.match(f.status(),/scene/i);assert.equal(f.calls.some(c=>c.id==='video.place_track'),false)}}],
+ ['backend errors and incomplete success cannot masquerade as placed',async()=>{for(const place of [()=>{throw Error('Clip hash mismatch')},()=>({ok:false,error:'Missing composition'}),()=>({ok:true})]){const f=fixture({place});await f.panel.load();await f.click('blender-place-submit');assert.doesNotMatch(f.status(),/^Placed/);assert.match(f.status(),/hash mismatch|Missing composition|confirmation/);assert.equal(f.nodes.get('blender-place-status').className,'image-error')}}],
+ ['pending placement is single-flight; stale completion cannot update another selection',async()=>{let finish;const f=fixture({place:()=>new Promise(resolve=>finish=resolve)});await f.panel.load();const p=f.click('blender-place-submit');await f.click('blender-place-submit');assert.equal(f.calls.filter(c=>c.id==='video.place_track').length,1);f.close();finish({ok:true});await p;assert.doesNotMatch(f.status(),/^Placed/)}],
+];
+let failed=0;for(const [name,test] of tests){try{await test();console.log('PASS placement: '+name)}catch(e){failed++;console.error('FAIL placement: '+name+'\n'+e.stack)}}assert.equal(failed,0,`${failed} placement regressions failed`);
diff --git c/apps/magicstudio-shell/ui/blender-placement.js i/apps/magicstudio-shell/ui/blender-placement.js
