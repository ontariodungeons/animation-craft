{
  "about": "Kinetic lyric library: how a meaning word performs (acts), how the other words arrive (entrances), how a line sits in the frame (layouts), and a transparent layer over the section (overlays: a HyperFrames registry block with a blend mode and opacity; blocks drawn on black use screen so the black disappears). Read by words.save/compose/apply.",
  "acts": {
    "jump": {
      "name": "Jump",
      "does": "Springs up from below",
      "from": {
        "y": 50,
        "opacity": 0
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "duration": 0.45,
        "ease": "back.out(3)"
      }
    },
    "drop": {
      "name": "Drop",
      "does": "Falls in and bounces",
      "from": {
        "y": -140,
        "opacity": 0
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "duration": 0.75,
        "ease": "bounce.out"
      }
    },
    "grow": {
      "name": "Grow",
      "does": "Swells up big",
      "from": {
        "scale": 0.3,
        "opacity": 0
      },
      "to": {
        "scale": 1.25,
        "opacity": 1,
        "duration": 0.8,
        "ease": "elastic.out(1, 0.5)"
      }
    },
    "shrink": {
      "name": "Shrink",
      "does": "Arrives big, ends small",
      "from": {
        "scale": 1.7,
        "opacity": 0
      },
      "to": {
        "scale": 0.85,
        "opacity": 1,
        "duration": 0.55,
        "ease": "power2.out"
      }
    },
    "wiggle": {
      "name": "Wiggle",
      "does": "Wobbles side to side",
      "from": {
        "rotation": -16,
        "opacity": 0
      },
      "to": {
        "rotation": 0,
        "opacity": 1,
        "duration": 0.9,
        "ease": "elastic.out(1.2, 0.3)"
      }
    },
    "spin": {
      "name": "Spin",
      "does": "Turns all the way around",
      "from": {
        "rotation": -360,
        "scale": 0.4,
        "opacity": 0
      },
      "to": {
        "rotation": 0,
        "scale": 1,
        "opacity": 1,
        "duration": 0.85,
        "ease": "back.out(1.4)"
      }
    },
    "stretch": {
      "name": "Stretch",
      "does": "Drags out slowly",
      "from": {
        "scaleX": 0.2,
        "opacity": 0
      },
      "to": {
        "scaleX": 1.35,
        "opacity": 1,
        "duration": 1.3,
        "ease": "power1.inOut"
      }
    },
    "shake": {
      "name": "Shake",
      "does": "Shakes like a wagging finger",
      "from": {
        "x": -34,
        "opacity": 1
      },
      "to": {
        "x": 0,
        "opacity": 1,
        "duration": 0.9,
        "ease": "elastic.out(1, 0.12)"
      }
    },
    "slam": {
      "name": "Slam",
      "does": "Hits the frame from close up",
      "from": {
        "scale": 3,
        "opacity": 0
      },
      "to": {
        "scale": 1,
        "opacity": 1,
        "duration": 0.25,
        "ease": "power4.in"
      }
    },
    "float": {
      "name": "Float",
      "does": "Drifts up softly",
      "from": {
        "y": 34,
        "opacity": 0
      },
      "to": {
        "y": -12,
        "opacity": 1,
        "duration": 1.4,
        "ease": "sine.inOut"
      }
    },
    "glow": {
      "name": "Glow",
      "does": "Grows warm and bright",
      "glow": true,
      "from": {
        "scale": 0.8,
        "opacity": 0
      },
      "to": {
        "scale": 1.15,
        "opacity": 1,
        "duration": 1.2,
        "ease": "sine.out"
      }
    },
    "letter-wave": {
      "name": "Letter wave",
      "does": "Letters ripple in",
      "letters": true,
      "stagger": 0.05,
      "from": {
        "y": 34,
        "opacity": 0
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "duration": 0.4,
        "ease": "back.out(2)"
      }
    },
    "letter-bounce": {
      "name": "Letter bounce",
      "does": "Letters bounce down one by one",
      "letters": true,
      "stagger": 0.06,
      "from": {
        "y": -70,
        "opacity": 0
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "duration": 0.6,
        "ease": "bounce.out"
      }
    },
    "dip": {
      "name": "Dip",
      "does": "Ducks in from above and pops back up",
      "from": {
        "y": -60,
        "opacity": 0
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "duration": 0.65,
        "ease": "back.out(3)"
      }
    }
  },
  "entrances": {
    "fade-up": {
      "name": "Fade up",
      "does": "Rises gently into place",
      "from": {
        "y": 18,
        "opacity": 0
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "duration": 0.3,
        "ease": "power2.out"
      }
    },
    "pop": {
      "name": "Pop",
      "does": "Pops in on the beat",
      "from": {
        "scale": 0.5,
        "opacity": 0
      },
      "to": {
        "scale": 1,
        "opacity": 1,
        "duration": 0.28,
        "ease": "back.out(2.5)"
      }
    },
    "slide": {
      "name": "Slide",
      "does": "Slides in from the left",
      "from": {
        "x": -40,
        "opacity": 0
      },
      "to": {
        "x": 0,
        "opacity": 1,
        "duration": 0.3,
        "ease": "power3.out"
      }
    },
    "drop-in": {
      "name": "Drop in",
      "does": "Drops from above",
      "from": {
        "y": -36,
        "opacity": 0
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "duration": 0.35,
        "ease": "bounce.out"
      }
    },
    "typewriter": {
      "name": "Typewriter",
      "does": "Letters type on",
      "letters": true,
      "stagger": 0.035,
      "from": {
        "opacity": 0
      },
      "to": {
        "opacity": 1,
        "duration": 0.01,
        "ease": "none"
      }
    },
    "blur-in": {
      "name": "Blur in",
      "does": "Comes into focus",
      "from": {
        "opacity": 0,
        "filter": "blur(12px)"
      },
      "to": {
        "opacity": 1,
        "filter": "blur(0px)",
        "duration": 0.35,
        "ease": "power2.out"
      }
    }
  },
  "layouts": {
    "karaoke": {
      "name": "Line",
      "does": "One or two centred rows"
    },
    "stack": {
      "name": "Stack",
      "does": "A few words per row, building down"
    },
    "scatter": {
      "name": "Scatter",
      "does": "Words land in loose, tilted places"
    },
    "cascade": {
      "name": "Cascade",
      "does": "Steps down the frame diagonally"
    },
    "push": {
      "name": "Push in",
      "does": "The line slowly grows towards you"
    },
    "giant": {
      "name": "Giant word",
      "does": "Each meaning word fills the frame for its beat"
    }
  },
  "overlays": {
    "none": {
      "name": "None",
      "does": "Just the scene"
    },
    "paper-grain": {
      "name": "Paper grain",
      "does": "A soft drifting texture, like felt and paper",
      "block": "fractal-noise",
      "blend": "soft-light",
      "opacity": 0.35
    },
    "godrays": {
      "name": "Sun rays",
      "does": "Light rays drift across the scene",
      "block": "godrays",
      "blend": "screen",
      "opacity": 0.35
    },
    "ripples": {
      "name": "Ripples",
      "does": "Water rings spread out from the centre",
      "block": "ripples",
      "blend": "screen",
      "opacity": 0.22
    },
    "lens-flare": {
      "name": "Lens flare",
      "does": "A warm sun flare shimmers",
      "block": "lens-flare",
      "blend": "screen",
      "opacity": 0.5
    },
    "sparkle-lines": {
      "name": "Falling sparkles",
      "does": "Thin bright lines fall gently",
      "block": "falling-lines",
      "blend": "screen",
      "opacity": 0.3
    },
    "starfield": {
      "name": "Starry night",
      "does": "Stars twinkle over the scene",
      "block": "starfield",
      "blend": "screen",
      "opacity": 0.7
    },
    "snow": {
      "name": "Snowfall",
      "does": "Soft flakes drift down",
      "block": "snow",
      "blend": "normal",
      "opacity": 0.85
    }
  }
}
